enum LibraryStatus {
  DRAFT
  PROCESSING
  PUBLISHED
  ARCHIVED
}

/// Standard/grade a volume belongs to, e.g. "V" (Std V) … "XII" (Std XII).
enum LibraryStandard {
  V
  VI
  VII
  VIII
  IX
  X
  XI
  XII
}

/// What kind of material the volume holds.
enum LibraryCategory {
  TEXTBOOK
  WORKBOOK
  REFERENCE
  QUESTION_PAPER
  PRACTICE_PAPER
  NOTEBOOK
  OTHER
}

model LibraryVolume {
  id                 String           @id @default(cuid()) @map("id")
  title              String           @map("title")
  slug               String           @unique @map("slug")
  description        String?          @map("description")
  author             String?          @map("author")
  publisher          String?          @map("publisher")
  academicYear       String?          @map("academic_year")
  standard           LibraryStandard  @map("standard")
  category           LibraryCategory  @default(TEXTBOOK) @map("category")
  subject            String?          @map("subject")
  institutionCode    InstitutionCode? @map("institution_code")
  language           String           @default("English") @map("language")
  status             LibraryStatus    @default(PROCESSING) @map("status")
  isPublished        Boolean          @default(false) @map("is_published")
  /// How far the PDF parser has got, 0-100. Shown while a volume is being
  /// prepared in the background.
  processingProgress Int              @default(0) @map("processing_progress")
  /// The step the parser is currently on, e.g. "Rendering page 40 of 300".
  processingStep     String?          @map("processing_step")
  /// Why the last processing attempt failed, if it did.
  processingError    String?          @map("processing_error")
  pageCount          Int              @default(0) @map("page_count")
  /// How many pages the source PDF really had. This can be more than
  /// `pageCount` when a long document was sampled down to the ceiling.
  sourcePageCount    Int              @default(0) @map("source_page_count")
  /// True when the source was longer than the page ceiling and was
  /// therefore sampled rather than rendered in full.
  isSampled          Boolean          @default(false) @map("is_sampled")
  wordCount          Int              @default(0) @map("word_count")
  readingMinutes     Int              @default(5) @map("reading_minutes")
  fileSizeBytes      Int              @default(0) @map("file_size_bytes")
  originalName       String?          @map("original_name")
  pdfPath            String?          @map("pdf_path")
  coverUrl           String?          @map("cover_url")
  keywords           String[]         @default([]) @map("keywords")
  excerpt            String?          @map("excerpt")
  viewCount          Int              @default(0) @map("view_count")
  publishedAt        DateTime?        @map("published_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  pages   LibraryVolumePage[]
  reviews LibraryVolumeReview[]

  // The catalogue is filtered by standard/category/subject on every page
  // load, so those columns are indexed.
  @@index([status, isPublished])
  @@index([standard])
  @@index([category])
  @@index([subject])
  @@index([institutionCode])
  @@index([publishedAt])
  @@index([title])
  @@map("library_volumes")
}

model LibraryVolumePage {
  id            String   @id @default(cuid()) @map("id")
  volumeId      String   @map("volume_id")
  pageNo        Int      @map("page_no")
  text          String   @default("") @map("text")
  imageVariants Json     @map("image_variants") // { thumb, w640, w1024, w1600, zoom }
  blurhash      String   @default("L6PZfSi_.AyE_3t7t7R**0o#DgR4") @map("blurhash")
  createdAt     DateTime @default(now()) @map("created_at")

  volume LibraryVolume @relation(fields: [volumeId], references: [id], onDelete: Cascade)

  @@unique([volumeId, pageNo])
  @@index([volumeId])
  @@map("library_volume_pages")
}

/// A reader's rating and comment on a volume.
///
/// A review may be left by a signed-in reader or by a guest. Guests are
/// identified by a device key rather than a user id, so a guest can review
/// without an account while still being limited to one review per volume.
model LibraryVolumeReview {
  id        String   @id @default(cuid()) @map("id")
  volumeId  String   @map("volume_id")
  /// Null for a guest review.
  userId    String?  @map("user_id")
  /// A stable per-device key for a guest review. Null for a signed-in reader.
  guestKey  String?  @map("guest_key")
  /// The name shown next to a guest review.
  guestName String?  @map("guest_name")
  rating    Int      @map("rating") // 1 to 5
  comment   String?  @map("comment")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  volume LibraryVolume @relation(fields: [volumeId], references: [id], onDelete: Cascade)
  user   User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One review per reader (or guest) per volume.
  @@unique([volumeId, userId])
  @@unique([volumeId, guestKey])
  @@index([volumeId])
  @@map("library_volume_reviews")
}
