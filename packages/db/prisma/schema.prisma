datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// PRIVACY NOTICE AND CONSENT EVIDENCE
// ----------------------------------------------------

model PrivacyConsentRecord {
  id               String   @id @default(cuid()) @map("id")
  subjectKey       String   @map("subject_key")
  purpose          String   @map("purpose")
  noticeVersion    String   @map("notice_version")
  action           String   @map("action") // GRANTED or WITHDRAWN
  channel          String   @map("channel")
  guardianVerified Boolean  @default(false) @map("guardian_verified")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([subjectKey, purpose, createdAt])
  @@map("privacy_consent_records")
}

model PrivacyRequest {
  id                 String                 @id @default(cuid()) @map("id")
  reference          String                 @unique @default(cuid()) @map("reference")
  name               String                 @map("name")
  email              String                 @map("email")
  type               String                 @map("type")
  details            String                 @map("details")
  status             String                 @default("RECEIVED") @map("status")
  assignedToUserId   String?                @map("assigned_to_user_id")
  identityStatus     String                 @default("UNVERIFIED") @map("identity_status")
  resolution         String?                @map("resolution")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  events             PrivacyRequestEvent[]

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@index([assignedToUserId, status])
  @@map("privacy_requests")
}

model PrivacyRequestEvent {
  id             String        @id @default(cuid()) @map("id")
  requestId      String        @map("request_id")
  actorUserId    String?       @map("actor_user_id")
  kind           String        @map("kind")
  message        String        @map("message")
  isInternal     Boolean       @default(true) @map("is_internal")
  createdAt      DateTime      @default(now()) @map("created_at")
  request        PrivacyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("privacy_request_events")
}

model GrievanceCase {
  id               String                 @id @default(cuid()) @map("id")
  reference        String                 @unique @default(cuid()) @map("reference")
  trackingTokenHash String                @unique @map("tracking_token_hash")
  name             String                 @map("name")
  email            String                 @map("email")
  category         String                 @map("category")
  subject          String                 @map("subject")
  description      String                 @map("description")
  status           String                 @default("RECEIVED") @map("status")
  restricted       Boolean                @default(false) @map("restricted")
  assignedToUserId String?                @map("assigned_to_user_id")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  events           GrievanceEvent[]

  @@index([status, createdAt])
  @@index([assignedToUserId, status])
  @@map("grievance_cases")
}

model GrievanceEvent {
  id            String        @id @default(cuid()) @map("id")
  caseId        String        @map("case_id")
  actorUserId   String?       @map("actor_user_id")
  kind          String        @map("kind")
  message       String        @map("message")
  isInternal    Boolean       @default(false) @map("is_internal")
  createdAt     DateTime      @default(now()) @map("created_at")
  grievanceCase GrievanceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("grievance_events")
}

// ----------------------------------------------------
// IDENTITY & USERS
// ----------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  FACULTY
  ALUMNI
  READER
}

enum InstitutionCode {
  NIRAKAR_HS
  TUDAL_HS
  ANGLE_HSS
}

enum VerificationLevel {
  UNVERIFIED
  EMAIL_VERIFIED
  VERIFIED
  TRUSTED
}

enum FacultyStatus {
  DRAFT
  PENDING
  PUBLISHED
}

enum FacultyMessageSender {
  VISITOR
  ADMIN
  FACULTY
}

model User {
  id           String    @id @default(cuid()) @map("id")
  email        String    @unique @map("email")
  username     String    @unique @map("username")
  passwordHash String    @map("password_hash")
  role         Role      @default(READER) @map("role")
  isSuspended  Boolean   @default(false) @map("is_suspended")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  refreshTokens   RefreshToken[]
  alumniProfile   AlumniProfile?
  facultyProfile  FacultyProfile?
  supporterPasses SupporterPass[]
  orders          Order[]
  payments        Payment[]
  readEvents      ReadEvent[]
  auditLogs       AuditLog[]
  posts           Post[]
  uploadedMedia   Media[]               @relation("MediaUploader")
  vouchesGiven    AlumniVouch[]         @relation("VoucherRelation")
  reportsFiled    ProfileReport[]       @relation("ReporterRelation")
  libraryReviews  LibraryVolumeReview[]
  magazineReviews MagazineIssueReview[]

  @@index([email])
  @@index([username])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid()) @map("id")
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false) @map("revoked")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model AlumniProfile {
  id                 String            @id @default(cuid()) @map("id")
  userId             String            @unique @map("user_id")
  firstName          String            @map("first_name")
  middleName         String?           @map("middle_name")
  lastName           String            @map("last_name")
  school             InstitutionCode   @map("school")
  batchYear          Int               @map("batch_year")
  photoUrl           String?           @map("photo_url")
  bio                String?           @map("bio")
  city               String?           @map("city")
  occupation         String?           @map("occupation")
  socialLinks        Json?             @default("[]") @map("social_links")
  visibilitySettings Json?             @default("{}") @map("visibility_settings")
  verificationLevel  VerificationLevel @default(UNVERIFIED) @map("verification_level")
  adminNotes         String?           @map("admin_notes")
  galleryPhotos      String[]          @default([]) @map("gallery_photos")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyMembers FamilyMember[]
  vouches       AlumniVouch[]   @relation("TargetProfileRelation")
  reports       ProfileReport[] @relation("ReportedProfileRelation")

  @@index([school])
  @@index([batchYear])
  @@index([verificationLevel])
  @@index([city])
  @@index([occupation])
  @@map("alumni_profiles")
}

model FamilyMember {
  id              String   @id @default(cuid()) @map("id")
  alumniProfileId String   @map("alumni_profile_id")
  name            String   @map("name")
  relation        String   @map("relation")
  photoUrl        String?  @map("photo_url")
  bio             String?  @map("bio")
  order           Int      @default(0) @map("order")
  createdAt       DateTime @default(now()) @map("created_at")

  alumniProfile AlumniProfile @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)

  @@index([alumniProfileId])
  @@map("family_members")
}

model AlumniVouch {
  id              String   @id @default(cuid()) @map("id")
  voucherId       String   @map("voucher_id")
  targetProfileId String   @map("target_profile_id")
  note            String?  @map("note")
  createdAt       DateTime @default(now()) @map("created_at")

  voucher       User          @relation("VoucherRelation", fields: [voucherId], references: [id], onDelete: Cascade)
  targetProfile AlumniProfile @relation("TargetProfileRelation", fields: [targetProfileId], references: [id], onDelete: Cascade)

  @@unique([voucherId, targetProfileId])
  @@index([targetProfileId])
  @@map("alumni_vouches")
}

model ProfileReport {
  id              String   @id @default(cuid()) @map("id")
  reporterId      String   @map("reporter_id")
  targetProfileId String   @map("target_profile_id")
  reason          String   @map("reason")
  status          String   @default("PENDING") @map("status") // PENDING, REVIEWED, DISMISSED
  createdAt       DateTime @default(now()) @map("created_at")

  reporter      User          @relation("ReporterRelation", fields: [reporterId], references: [id], onDelete: Cascade)
  targetProfile AlumniProfile @relation("ReportedProfileRelation", fields: [targetProfileId], references: [id], onDelete: Cascade)

  @@index([targetProfileId])
  @@index([status])
  @@map("profile_reports")
}

// ----------------------------------------------------
// INSTITUTIONS & FACULTY
// ----------------------------------------------------

model Institution {
  id        String          @id @default(cuid()) @map("id")
  code      InstitutionCode @unique @map("code")
  name      String          @map("name")
  slug      String          @unique @map("slug")
  tagline   String          @map("tagline")
  history   String?         @map("history")
  vision    String?         @map("vision")
  bannerUrl String?         @map("banner_url")
  profile   Json            @default("{}") @map("profile")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  facultyProfiles FacultyProfile[]
  committees      Committee[]

  @@map("institutions")
}

model FacultyProfile {
  id                   String          @id @default(cuid()) @map("id")
  userId               String?         @unique @map("user_id")
  institutionId        String          @map("institution_id")
  institutionCode      InstitutionCode @map("institution_code")
  designation          String          @map("designation")
  department           String          @map("department")
  subjects             String[]        @default([]) @map("subjects")
  qualification        String          @map("qualification")
  experience           String          @map("experience")
  bio                  String?         @map("bio")
  achievements         String[]        @default([]) @map("achievements")
  photoUrl             String?         @map("photo_url")
  publicContactToggles Json?           @default("{\"showEmail\": false, \"showPhone\": false}") @map("public_contact_toggles")
  order                Int             @default(0) @map("order")
  status               FacultyStatus   @default(PUBLISHED) @map("status")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  user            User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  institution     Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  conversations   FacultyConversation[]
  magazineReviews MagazineIssueReview[]

  @@index([institutionCode])
  @@index([status])
  @@index([order])
  @@map("faculty_profiles")
}

model FacultyConversation {
  id               String   @id @default(cuid()) @map("id")
  facultyProfileId String   @map("faculty_profile_id")
  parentName       String   @map("parent_name")
  studentName      String?  @map("student_name")
  classGrade       String?  @map("class_grade")
  phone            String?  @map("phone")
  email            String?  @map("email")
  visitorTokenHash String   @unique @map("visitor_token_hash")
  lastMessageAt    DateTime @default(now()) @map("last_message_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  facultyProfile FacultyProfile               @relation(fields: [facultyProfileId], references: [id], onDelete: Cascade)
  messages       FacultyConversationMessage[]

  @@index([facultyProfileId, lastMessageAt])
  @@map("faculty_conversations")
}

model FacultyConversationMessage {
  id             String               @id @default(cuid()) @map("id")
  conversationId String               @map("conversation_id")
  sender         FacultyMessageSender
  body           String
  readAt         DateTime?            @map("read_at")
  createdAt      DateTime             @default(now()) @map("created_at")

  conversation FacultyConversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  FacultyConversationAttachment[]

  @@index([conversationId, createdAt])
  @@index([conversationId, sender, readAt])
  @@map("faculty_conversation_messages")
}

model FacultyConversationAttachment {
  id           String   @id @default(cuid()) @map("id")
  messageId    String   @map("message_id")
  originalName String   @map("original_name")
  storageName  String   @unique @map("storage_name")
  mimeType     String   @map("mime_type")
  size         Int      @map("size")
  createdAt    DateTime @default(now()) @map("created_at")

  message FacultyConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("faculty_conversation_attachments")
}

enum FacultyMessageIdentityType {
  VISITOR
  FACULTY
}

model FacultyMessageModeration {
  id              String                     @id @default(cuid()) @map("id")
  identityType    FacultyMessageIdentityType @map("identity_type")
  identityHash    String                     @map("identity_hash")
  strikes         Int                        @default(0) @map("strikes")
  lastViolationAt DateTime?                  @map("last_violation_at")
  cooldownUntil   DateTime?                  @map("cooldown_until")
  blockedUntil    DateTime?                  @map("blocked_until")
  manualBlockedAt DateTime?                  @map("manual_blocked_at")
  manualBlockedBy String?                    @map("manual_blocked_by")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  @@unique([identityType, identityHash])
  @@index([blockedUntil])
  @@map("faculty_message_moderation")
}

// ----------------------------------------------------
// CONTENT & STRUCTURE
// ----------------------------------------------------

model Committee {
  id            String   @id @default(cuid()) @map("id")
  institutionId String?  @map("institution_id")
  name          String   @map("name")
  slug          String   @map("slug")
  description   String?  @map("description")
  order         Int      @default(0) @map("order")
  createdAt     DateTime @default(now()) @map("created_at")

  institution Institution?      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  members     CommitteeMember[]

  @@unique([slug, institutionId])
  @@index([institutionId])
  @@map("committees")
}

model CommitteeMember {
  id          String   @id @default(cuid()) @map("id")
  committeeId String   @map("committee_id")
  name        String   @map("name")
  designation String   @map("designation")
  role        String   @default("Member") @map("role")
  photoUrl    String?  @map("photo_url")
  order       Int      @default(0) @map("order")
  createdAt   DateTime @default(now()) @map("created_at")

  committee Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  @@index([committeeId])
  @@map("committee_members")
}

model Founder {
  id        String   @id @default(cuid()) @map("id")
  name      String   @map("name")
  title     String   @map("title")
  bio       String?  @map("bio")
  period    String?  @map("period")
  photoUrl  String?  @map("photo_url")
  order     Int      @default(0) @map("order")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([order])
  @@map("founders")
}

model Honour {
  id          String   @id @default(cuid()) @map("id")
  title       String   @map("title")
  recipient   String   @map("recipient")
  year        Int      @map("year")
  description String?  @map("description")
  photoUrl    String?  @map("photo_url")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([year])
  @@map("honours")
}

model Notice {
  id              String           @id @default(cuid()) @map("id")
  institutionCode InstitutionCode? @map("institution_code")
  title           String           @map("title")
  content         String?          @map("content")
  date            String           @map("date") // YYYY-MM-DD
  pinned          Boolean          @default(false) @map("pinned")
  pdfUrl          String?          @map("pdf_url")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([institutionCode])
  @@index([date])
  @@index([pinned])
  @@map("notices")
}

model Activity {
  id              String           @id @default(cuid()) @map("id")
  institutionCode InstitutionCode? @map("institution_code")
  title           String           @map("title")
  description     String           @map("description")
  category        String           @default("General") @map("category")
  date            String           @map("date")
  photos          String[]         @default([]) @map("photos")
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([institutionCode])
  @@index([date])
  @@map("activities")
}

model NewsEvent {
  id              String           @id @default(cuid()) @map("id")
  institutionCode InstitutionCode? @map("institution_code")
  title           String           @map("title")
  excerpt         String?          @map("excerpt")
  content         String           @map("content")
  date            String           @map("date")
  coverUrl        String?          @map("cover_url")
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([institutionCode])
  @@index([date])
  @@map("news_events")
}

model Event {
  id              String           @id @default(cuid()) @map("id")
  institutionCode InstitutionCode? @map("institution_code")
  title           String           @map("title")
  description     String?          @map("description")
  startDate       String           @map("start_date")
  endDate         String?          @map("end_date")
  location        String?          @map("location")
  isUpcoming      Boolean          @default(true) @map("is_upcoming")
  coverUrl        String?          @map("cover_url")
  pdfUrl          String?          @map("pdf_url")
  photos          Json?            @default("[]") @map("photos")
  documents       Json?            @default("[]") @map("documents")
  videoUrl        String?          @map("video_url")
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([institutionCode])
  @@index([isUpcoming])
  @@index([startDate])
  @@map("events")
}

model GalleryAlbum {
  id              String           @id @default(cuid()) @map("id")
  institutionCode InstitutionCode? @map("institution_code")
  title           String           @map("title")
  description     String?          @map("description")
  category        String           @default("Campus") @map("category")
  coverUrl        String?          @map("cover_url")
  createdAt       DateTime         @default(now()) @map("created_at")

  items GalleryItem[]

  @@index([institutionCode])
  @@map("gallery_albums")
}

model GalleryItem {
  id        String   @id @default(cuid()) @map("id")
  albumId   String   @map("album_id")
  title     String   @map("title")
  mediaUrl  String   @map("media_url")
  caption   String?  @map("caption")
  order     Int      @default(0) @map("order")
  createdAt DateTime @default(now()) @map("created_at")

  album GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId])
  @@map("gallery_items")
}

/// The streams a graduating batch can belong to.
enum BatchStream {
  SSC
  HSSC_SCIENCE
  HSSC_COMMERCE
  HSSC_ARTS
  SPECIAL
}

model BatchPhoto {
  id              String          @id @default(cuid()) @map("id")
  institutionCode InstitutionCode @map("institution_code")
  batchYear       Int             @map("batch_year")
  title           String          @map("title")
  photoUrl        String          @map("photo_url")
  caption         String?         @map("caption")
  /// The stream the batch belonged to, which the archive sorts itself by.
  stream          BatchStream     @default(SSC) @map("stream")
  /// The academic session, written out as it was on the print ("2022-23").
  batchSession    String?         @map("batch_session")
  /// The class the students sat in ("Std X", "Std XII").
  classLevel      String?         @map("class_level")
  /// The section within the class ("Div A"), when the photograph names one.
  division        String?         @map("division")
  /// The size of the stored file in bytes, so the archive can show it
  /// without having to fetch the file first.
  fileSizeBytes   Int             @default(0) @map("file_size_bytes")
  /// The format the photograph was stored in. Uploads are converted on the
  /// way in, so this is always a modern format rather than what was picked.
  imageFormat     String          @default("webp") @map("image_format")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([institutionCode, batchYear])
  @@index([stream])
  @@map("batch_photos")
}

model Blog {
  id         String   @id @default(cuid()) @map("id")
  authorName String   @map("author_name")
  authorRole String   @default("Alumnus") @map("author_role")
  school     String?  @map("school")
  title      String   @map("title")
  body       String   @map("body")
  coverUrl   String?  @map("cover_url")
  status     String   @default("PUBLISHED") @map("status")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([status])
  @@index([createdAt])
  @@map("blogs")
}

model Comment {
  id         String   @id @default(cuid()) @map("id")
  authorName String   @map("author_name")
  email      String?  @map("email")
  place      String?  @map("place")
  content    String   @map("content")
  targetType String   @map("target_type") // BLOG, POST, GENERAL, EVENT
  targetId   String?  @map("target_id")
  status     String   @default("APPROVED") @map("status") // PENDING, APPROVED, REJECTED
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@index([targetType, targetId, status, createdAt])
  @@index([status])
  @@map("comments")
}

model ContactMessage {
  id        String   @id @default(cuid()) @map("id")
  name      String   @map("name")
  email     String   @map("email")
  phone     String?  @map("phone")
  subject   String   @map("subject")
  message   String   @map("message")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([isRead])
  @@index([createdAt])
  @@map("contact_messages")
}

model Page {
  id              String   @id @default(cuid()) @map("id")
  slug            String   @unique @map("slug")
  title           String   @map("title")
  metaDescription String?  @map("meta_description")
  published       Boolean  @default(true) @map("published")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  sections PageSection[]

  @@index([slug])
  @@map("pages")
}

model PageSection {
  id       String  @id @default(cuid()) @map("id")
  pageId   String  @map("page_id")
  type     String  @map("type")
  order    Int     @default(0) @map("order")
  title    String? @map("title")
  subtitle String? @map("subtitle")
  content  Json    @map("content")
  visible  Boolean @default(true) @map("visible")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([order])
  @@map("page_sections")
}

model Menu {
  id        String   @id @default(cuid()) @map("id")
  name      String   @unique @map("name")
  location  String   @unique @map("location") // HEADER, FOOTER, UTILITY
  createdAt DateTime @default(now()) @map("created_at")

  items MenuItem[]

  @@map("menus")
}

model MenuItem {
  id        String   @id @default(cuid()) @map("id")
  menuId    String   @map("menu_id")
  parentId  String?  @map("parent_id")
  label     String   @map("label")
  url       String   @map("url")
  order     Int      @default(0) @map("order")
  target    String   @default("_self") @map("target")
  icon      String?  @map("icon")
  createdAt DateTime @default(now()) @map("created_at")

  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuHierarchy")

  @@index([menuId])
  @@index([parentId])
  @@index([order])
  @@map("menu_items")
}

model Media {
  id            String   @id @default(cuid()) @map("id")
  filename      String   @unique @map("filename")
  originalName  String   @map("original_name")
  mimeType      String   @map("mime_type")
  sizeBytes     Int      @map("size_bytes")
  width         Int      @map("width")
  height        Int      @map("height")
  blurhash      String   @default("L6PZfSi_.AyE_3t7t7R**0o#DgR4") @map("blurhash")
  dominantColor String   @default("#9b1e1e") @map("dominant_color")
