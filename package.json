{
  "name": "nirakar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "npm run build --workspace @nirakar/shared && npm run build --workspace @nirakar/db && npm run build --workspaces --if-present",
    "build:pages:web": "npm run build --workspace @nirakar/shared && npm run build --workspace @nirakar/web",
    "build:pages:admin": "npm run build --workspace @nirakar/shared && npm run build --workspace @nirakar/admin",
    "start": "node apps/api/dist/server.js",
    "lint": "eslint . --ignore-pattern node_modules --ignore-pattern dist --ignore-pattern uploads --ignore-pattern private-uploads --ignore-pattern .tmp-magazine-tests",
    "test": "vitest run",
    "db:migrate": "npx prisma migrate deploy --schema=packages/db/prisma/schema.prisma",
    "db:seed": "tsx packages/db/src/seed.ts",
    "db:import": "tsx scripts/import-legacy.ts",
    "fb:sync": "tsx scripts/sync-facebook.ts",
    "db:studio": "npx prisma studio --schema=packages/db/prisma/schema.prisma",
    "check:banned": "tsx scripts/check-banned-words.ts",
    "theme": "tsx scripts/brand-colors.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "cheerio": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
